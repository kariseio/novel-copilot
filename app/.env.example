# 이 파일을 app/.env 로 복사하고 값을 채운다. (.env 는 git 에서 제외)
#   Copy-Item .env.example .env
# novelcopilot/config.py 가 import 시 이 파일을 프로세스 환경으로 로드한다(override=True — .env 가 단일 출처).
# NOVEL_* 항목은 config.py 의 Settings 필드와 1:1 — 필드명을 대문자로 바꾸고 NOVEL_ 을 붙이면 어떤 필드든 덮어쓴다.
# 값이 비어 있거나 줄이 주석이면 config.py 의 기본값이 쓰인다.

# --- API 키 ---
ANTHROPIC_API_KEY=            # 필수 — 본문 집필·세계관 설계(기본 프로바이더)
OPENAI_API_KEY=               # 필수 — 임베딩(RAG)·교차 벤더 심사·표지 이미지
GEMINI_API_KEY=               # 선택 — 모델 라우팅에 gemini:... 를 쓸 때만(GOOGLE_API_KEY 로 넣어도 인식)

# --- 서버 (run.py) ---
# NOVEL_HOST=127.0.0.1
# NOVEL_PORT=8000
# NOVEL_RELOAD=1              # 코드 변경 시 자동 재시작(개발용)
# NOVEL_DATA_DIR=             # 작품 데이터 저장 위치. 비우면 app/data/

# --- 모델 라우팅 (선택) — 형식 "프로바이더:모델". 프로바이더 생략 시 NOVEL_LLM_PROVIDER 적용. 기본값은 config.py ---
# NOVEL_LLM_PROVIDER=anthropic
# NOVEL_GEN_MODEL=                # 본문 집필
# NOVEL_WORLDGEN_MODEL=           # 세계관 설계 (예: anthropic:claude-opus-4-8)
# NOVEL_PLANNING_MODEL=           # 아크·회차 설계
# NOVEL_AUX_MODEL=                # 보조 스테이지
# NOVEL_EXTRACT_MODEL=            # 추출 스테이지
# NOVEL_STYLE_JUDGE_MODEL=        # 문체 심사 — 집필과 다른 벤더 권장 (예: openai:gpt-5.6)
# NOVEL_EMBED_MODEL=text-embedding-3-small   # 임베딩(OpenAI)

# --- 로그·관측 (선택) ---
# NOVEL_PROMPT_LOG=1          # LLM 콜 전문을 app/logs/prompts/ 에 저장. 기본 켜짐, 0 으로 끔
# LANGSMITH_TRACING=1         # LangSmith 트레이싱 (pip install langsmith)
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=
